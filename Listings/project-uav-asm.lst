 136   1          I2C_SCL = 0;
 137   1      }
 138          
 139          void I2C_Stop(void) {
 140   1          I2C_SDA = 0; I2C_SCL = 1;
 141   1          I2C_SDA = 1;
 142   1      }
 143          
 144          void I2C_Write(unsigned char dat) {
 145   1          unsigned char i;
 146   1          for(i = 0; i < 8; i++) {
 147   2              I2C_SDA = (dat & 0x80) ? 1 : 0;
 148   2              I2C_SCL = 1;
 149   2              I2C_SCL = 0;
 150   2              dat <<= 1;
 151   2          }
 152   1          I2C_SDA = 1; I2C_SCL = 1;
 153   1          I2C_SCL = 0;
 154   1      }
