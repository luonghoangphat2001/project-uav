 333          
 334          void Determine_State(void) {
 335   1          if(current_temp >= 80)           currentState = BIG_FIRE;
 336   1          else if(current_temp >= 50)      currentState = SMALL_FIRE;
 337   1          else if(GAS_PIN == 0)            currentState = GAS_LEAK;
 338   1          else if(rain_active)             currentState = RAIN_WARNING;
 339   1          else if(distance_cm < 20)        currentState = OBSTACLE;
 340   1          else if(intruder_active)         currentState = INTRUDER;
 341   1          else if(motion_active)           currentState = MOTION;
 342   1          else                             currentState = NORMAL;
 343   1      }
