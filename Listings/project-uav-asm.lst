 250          unsigned int Read_Sonar(void) {
 251   1          unsigned int time;
 252   1          unsigned int timeout = 0;
 253   1      
 254   1          TR = 1;
 255   1          Delay_Trigger();
 256   1          TR = 0;
 257   1      
 258   1          while(!ECHO) {
 259   2              if(++timeout > 500) return 999;
 260   2          }
 261   1      
 262   1          TH0 = 0; TL0 = 0; TF0 = 0;
 263   1          TR0 = 1;
 264   1          while(ECHO && !TF0);
 265   1          TR0 = 0;
 266   1      
 267   1          if(TF0) { TF0 = 0; return 999; }
 268   1          time = (TH0 << 8) | TL0;
 269   1          return (time >> 6); 
 270   1      }
