 165          
 166          void LCD_Write_Nibble(unsigned char nibble, unsigned char rs) {
 167   1          unsigned char d = (nibble & 0xF0) | rs;
 168   1          LCD_Send_I2C(d | 0x04);
 169   1          LCD_Send_I2C(d & ~0x04);
 170   1      }
 171          
 172          void LCD_Cmd(unsigned char cmd) {
 173   1          LCD_Write_Nibble(cmd, 0);
 174   1          LCD_Write_Nibble(cmd << 4, 0);
 175   1          Delay_ms(1);
 176   1      }
